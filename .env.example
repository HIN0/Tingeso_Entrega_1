# Copy this file to ".env" (same folder as compose.yml) before running docker compose:
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# ".env" is ignored by Git: real passwords must never be committed.
#
# The values below are LOCAL DEMO values. Change them for any shared or public environment.
# Note: PostgreSQL only applies DB_PASSWORD when its volume is created for the first time;
# after changing it, recreate the database with "docker compose down -v".

# PostgreSQL (used by the db container and by the 3 backend replicas)
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Keycloak admin console (http://localhost:8090)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
